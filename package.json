{
  "name": "aurora-icon-theme",
  "displayName": "Aurora Icon Theme",
  "description": "Aurora Icon Theme for Visual Studio Code",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean:icons": "tsx ./src/scripts/icons/cleanIcons.ts",
    "clean:dist": "tsx ./src/scripts/cleanDist.ts",
    "precompile": "npm run clean:dist && npm run clean:icons && npm run verify",
    "compile": "tsc -p ./",
    "postcompile": "npm run generateJson && npm run generateOpenFolders && npm run generateClones && npm run check",
    "build": "npm run compile && tsx ./build/build-with-esbuild.ts",
    "watch": "tsx ./build/watch-with-esbuild.ts",
    "check": "tsx ./src/scripts/icons/checks/run.ts",
    "generateJson": "tsx ./src/scripts/icons/generateJson.ts > ./dist/aurora-icons.json",
    "generateClones": "tsx ./src/scripts/icons/generateClones.ts",
    "generateOpenFolders": "tsx ./src/scripts/svg/generateOpenFolderIcons.ts",
    "lint": "biome check",
    "format": "biome format --write ./src",
    "preview": "tsx ./src/scripts/preview/run.ts",
    "svgo": "svgo -i icons -o icons -q",
    "vscode:prepublish": "npm run lint && npm run build",
    "verify": "sheriff verify"
  },
  "publisher": "aurorp1g",
  "author": {
    "name": "aurorp1g",
    "email": "aurorp1g@gmail.com",
    "url": "https://github.com/aurorp1g"
  },
  "engines": {
    "vscode": "^1.55.0"
  },
  "homepage": "https://github.com/aurorp1g/vscode-aurora-icon-theme/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurorp1g/vscode-aurora-icon-theme.git"
  },
  "bugs": {
    "url": "https://github.com/aurorp1g/vscode-aurora-icon-theme/issues"
  },
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#282c34",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "icons",
    "theme",
    "material",
    "icon-theme",
    "customization"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension/desktop/extension.cjs",
  "browser": "./dist/extension/web/extension.cjs",
  "contributes": {
    "iconThemes": [
      {
        "id": "aurora-icon-theme",
        "label": "Aurora Icon Theme",
        "path": "./dist/aurora-icons.json",
        "_watch": true
      }
    ],
    "commands": [
      {
        "command": "aurora-icon-theme.activateIcons",
        "title": "%command.activateIcons%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.toggleIconPacks",
        "title": "%command.toggleIconPacks%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.changeFolderTheme",
        "title": "%command.changeFolderTheme%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.changeFolderColor",
        "title": "%command.changeFolderColor%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.changeRootFolderColor",
        "title": "%command.changeRootFolderColor%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.changeFileColor",
        "title": "%command.changeFileColor%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.restoreDefaultConfig",
        "title": "%command.restoreDefaultConfig%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.toggleExplorerArrows",
        "title": "%command.toggleExplorerArrows%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.changeOpacity",
        "title": "%command.changeOpacity%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.toggleGrayscale",
        "title": "%command.toggleGrayscale%",
        "enablement": "!isWeb"
      },
      {
        "command": "aurora-icon-theme.changeSaturation",
        "title": "%command.changeSaturation%",
        "enablement": "!isWeb"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "aurora-icon-theme.activeIconPack": {
          "type": "string",
          "default": "angular",
          "description": "%configuration.activeIconPack%",
          "enumDescriptions": [
            "%configuration.activeIconPack.angular%",
            "%configuration.activeIconPack.angular_ngrx%",
            "%configuration.activeIconPack.react%",
            "%configuration.activeIconPack.react_redux%",
            "%configuration.activeIconPack.roblox%",
            "%configuration.activeIconPack.qwik%",
            "%configuration.activeIconPack.vue%",
            "%configuration.activeIconPack.vue_vuex%",
            "%configuration.activeIconPack.nest%",
            "%configuration.activeIconPack.bashly%",
            "%configuration.activeIconPack.none%"
          ],
          "enum": [
            "angular",
            "angular_ngrx",
            "react",
            "react_redux",
            "roblox",
            "qwik",
            "vue",
            "vue_vuex",
            "nest",
            "bashly",
            "none"
          ]
        },
        "aurora-icon-theme.files.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.files.associations%"
        },
        "aurora-icon-theme.folders.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.folders.associations%"
        },
        "aurora-icon-theme.rootFolders.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.rootFolders.associations%"
        },
        "aurora-icon-theme.languages.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.languages.associations%"
        },
        "aurora-icon-theme.files.customClones": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.customClones.name%"
              },
              "base": {
                "type": "string",
                "description": "%configuration.customClones.base%"
              },
              "color": {
                "type": "string",
                "description": "%configuration.customClones.color%"
              },
              "lightColor": {
                "type": "string",
                "description": "%configuration.customClones.lightColor%"
              },
              "fileNames": {
                "type": "array",
                "default": [],
                "description": "%configuration.customClones.fileNames%",
                "items": {
                  "type": "string"
                }
              },
              "fileExtensions": {
                "type": "array",
                "default": [],
                "description": "%configuration.customClones.fileExtensions%",
                "items": {
                  "type": "string"
                }
              },
              "activeForPacks": {
                "type": "array",
                "default": [
                  "angular"
                ],
                "description": "%configuration.customClones.activeForPacks%",
                "items": {
                  "type": "string",
                  "enumDescriptions": [
                    "%configuration.activeIconPack.angular%",
                    "%configuration.activeIconPack.angular_ngrx%",
                    "%configuration.activeIconPack.react%",
                    "%configuration.activeIconPack.react_redux%",
                    "%configuration.activeIconPack.roblox%",
                    "%configuration.activeIconPack.qwik%",
                    "%configuration.activeIconPack.vue%",
                    "%configuration.activeIconPack.vue_vuex%",
                    "%configuration.activeIconPack.nest%",
                    "%configuration.activeIconPack.bashly%",
                    "%configuration.activeIconPack.none%"
                  ],
                  "enum": [
                    "angular",
                    "angular_ngrx",
                    "react",
                    "react_redux",
                    "qwik",
                    "vue",
                    "vue_vuex",
                    "nest",
                    "bashly",
                    "none"
                  ]
                }
              }
            }
          },
          "description": "%configuration.customClones%"
        },
        "aurora-icon-theme.languages.customClones": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.customClones.name%"
              },
              "base": {
                "type": "string",
                "description": "%configuration.customClones.base%"
              },
              "color": {
                "type": "string",
                "description": "%configuration.customClones.color%"
              },
              "lightColor": {
                "type": "string",
                "description": "%configuration.customClones.lightColor%"
              },
              "ids": {
                "type": "array",
                "default": [],
                "description": "%configuration.customClones.ids%",
                "items": {
                  "type": "string"
                }
              },
              "activeForPacks": {
                "type": "array",
                "default": [
                  "angular"
                ],
                "description": "%configuration.customClones.activeForPacks%",
                "items": {
                  "type": "string",
                  "enumDescriptions": [
                    "%configuration.activeIconPack.angular%",
                    "%configuration.activeIconPack.angular_ngrx%",
                    "%configuration.activeIconPack.react%",
                    "%configuration.activeIconPack.react_redux%",
                    "%configuration.activeIconPack.roblox%",
                    "%configuration.activeIconPack.qwik%",
                    "%configuration.activeIconPack.vue%",
                    "%configuration.activeIconPack.vue_vuex%",
                    "%configuration.activeIconPack.nest%",
                    "%configuration.activeIconPack.bashly%",
                    "%configuration.activeIconPack.none%"
                  ],
                  "enum": [
                    "angular",
                    "angular_ngrx",
                    "react",
                    "react_redux",
                    "qwik",
                    "vue",
                    "vue_vuex",
                    "nest",
                    "bashly",
                    "none"
                  ]
                }
              }
            }
          },
          "description": "%configuration.customClones%"
        },
        "aurora-icon-theme.folders.customClones": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.customClones.name%"
              },
              "base": {
                "type": "string",
                "description": "%configuration.customClones.base%"
              },
              "color": {
                "type": "string",
                "description": "%configuration.customClones.color%"
              },
              "lightColor": {
                "type": "string",
                "description": "%configuration.customClones.lightColor%"
              },
              "folderNames": {
                "type": "array",
                "description": "%configuration.customClones.folderNames%",
                "items": {
                  "type": "string"
                }
              },
              "rootFolderNames": {
                "type": "array",
                "description": "%configuration.customClones.rootFolderNames%",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "%configuration.customClones%"
        },
        "aurora-icon-theme.folders.theme": {
          "type": "string",
          "default": "specific",
          "description": "%configuration.folders.theme%",
          "enumDescriptions": [
            "%configuration.folders.theme.specific%",
            "%configuration.folders.theme.classic%",
            "%configuration.folders.theme.none%"
          ],
          "enum": [
            "specific",
            "classic",
            "none"
          ]
        },
        "aurora-icon-theme.folders.color": {
          "type": "string",
          "default": "#90a4ae",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "%configuration.folders.color%"
        },
        "aurora-icon-theme.rootFolders.color": {
          "type": "string",
          "default": "#90a4ae",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "%configuration.rootFolders.color%"
        },
        "aurora-icon-theme.files.color": {
          "type": "string",
          "default": "#90a4ae",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "%configuration.files.color%"
        },
        "aurora-icon-theme.opacity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "%configuration.opacity%"
        },
        "aurora-icon-theme.hidesExplorerArrows": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.hidesExplorerArrows%"
        },
        "aurora-icon-theme.saturation": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "%configuration.saturation%"
        },
        "aurora-icon-theme.enableLogging": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.enableLogging%"
        },
        "aurora-icon-theme.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "info",
            "error",
            "debug"
          ],
          "description": "%configuration.logLevel%"
        }
      }
    }
  },
  "dependencies": {
    "chroma-js": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@softarc/sheriff-core": "^0.20.0",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.55.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vscode/vsce": "^4.1.1",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.17.0",
    "svgo": "^4.0.2",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.11.0": true
  }
}
